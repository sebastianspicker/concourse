{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "INSTITUTION_ID",
    "BFF_PORT",
    "CORS_ORIGINS",
    "BFF_TRUST_PROXY",
    "BFF_TRUSTED_PROXIES",
    "BFF_DEFAULT_CACHE_TTL",
    "BFF_REQUIRE_AUTH",
    "BFF_AUTH_TOKEN",
    "RRULE_EXPANSION_HORIZON_DAYS",
    "APP_VERSION",
    "CONCOURSE_STATIC_DEMO",
    "EXPO_PUBLIC_BFF_BASE_URL",
    "PUBLIC_EVENTS_MODE",
    "PUBLIC_EVENTS_DATE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "dependsOn": ["^build"],
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  },
  "globalDependencies": [
    "scripts/clean-package-dist.mjs",
    "tsconfig.base.json"
  ]
}
