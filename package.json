{
  "name": "concourse-campus-kit",
  "private": true,
  "version": "1.2.0-alpha.1",
  "description": "Expo client and Node BFF for public university campus information.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sebastianspicker/concourse-campus-kit.git"
  },
  "homepage": "https://github.com/sebastianspicker/concourse-campus-kit#readme",
  "bugs": {
    "url": "https://github.com/sebastianspicker/concourse-campus-kit/issues"
  },
  "keywords": [
    "accessibility",
    "campus-app",
    "expo",
    "react-native",
    "typescript",
    "university"
  ],
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:demo": "pnpm --filter @concourse/contracts build && pnpm --filter @concourse/institutions build && CONCOURSE_STATIC_DEMO=1 INSTITUTION_ID=example pnpm --filter @concourse/client exec expo export --platform web --output-dir ../../dist-pages --clear && node scripts/prepare-pages-output.mjs",
    "dev": "turbo run dev --parallel",
    "lint": "eslint apps/api/vitest.config.ts apps/client/vitest.config.ts apps/client/app.config.ts playwright.config.mjs apps/client/e2e-web --ext .mjs && turbo run lint",
    "typecheck": "tsc -p tsconfig.tools.json && turbo run typecheck",
    "test": "turbo run test",
    "check:architecture": "node scripts/check-architecture.mjs",
    "verify:demo:artifact": "node scripts/verify-pages-output.mjs",
    "capture:screenshots": "node scripts/capture-screenshots.mjs",
    "release:check": "node scripts/verify-release-metadata.mjs",
    "verify": "./scripts/verify-production-ready.sh",
    "setup:dev": "./scripts/setup-dev.sh",
    "test:tools": "node --test scripts/__tests__/*.test.mjs",
    "test:web": "playwright test",
    "verify:web": "pnpm build:demo && pnpm verify:demo:artifact && pnpm build:web:client && CONCOURSE_WEB_BUILD=production pnpm test:web",
    "verify:containers": "node scripts/verify-containers.mjs",
    "build:web:client": "pnpm --filter @concourse/contracts build && pnpm --filter @concourse/institutions build && CONCOURSE_STATIC_DEMO=0 INSTITUTION_ID=example EXPO_PUBLIC_BFF_BASE_URL=https://bff.example.edu pnpm --filter @concourse/client exec expo export --platform web --output-dir ../../build/web-profile --clear"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.7",
    "@typescript-eslint/eslint-plugin": "8.63.0",
    "@typescript-eslint/parser": "8.63.0",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "tsx": "4.21.0",
    "turbo": "2.9.14",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1",
      "@babel/core@>=7 <7.29.6": "7.29.6",
      "@isaacs/brace-expansion@<=5.0.0": "5.0.1",
      "@babel/plugin-transform-modules-systemjs@<7.29.4": "7.29.4",
      "@remix-run/server-runtime@<2.17.5": "2.17.5",
      "@xmldom/xmldom@<0.8.15": "0.8.15",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12",
      "fast-uri@>=3 <3.1.5": "3.1.5",
      "fast-xml-builder@<1.1.7": "1.1.7",
      "fast-xml-parser@<5.7.0": "5.7.0",
      "flatted@<=3.4.1": "3.4.2",
      "form-data@>=3 <3.0.5": "3.0.5",
      "form-data@>=4 <4.0.6": "4.0.6",
      "handlebars@>=4.0.0 <=4.7.8": "4.7.9",
      "joi@>=17 <17.13.8": "17.13.8",
      "js-yaml@>=3 <3.15.2": "3.15.2",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "node-forge@<1.4.0": "1.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=3.0.0 <3.0.2": "3.0.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "browserslist@<4.28.7": "4.28.7",
      "baseline-browser-mapping@<2.11.0": "2.11.0",
      "decode-uri-component@<0.5.0": "0.5.0",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "qs": "6.16.0",
      "rollup@>=4.0.0 <4.59.0": "4.60.3",
      "send@<0.19.0": "0.19.0",
      "shell-quote@>=1 <1.9.0": "1.9.0",
      "tar@<7.5.16": "7.5.16",
      "@expo/cli@0.18.31>tar": "7.5.16",
      "cacache@18.0.4>tar": "7.5.16",
      "turbo-stream@<3.0.0": "3.0.0",
      "tmp": "0.2.7",
      "undici@<6.27.0": "6.27.0",
      "uuid@<14.0.0": "14.0.0",
      "vite@<6.4.3": "6.4.3",
      "ws@>=6 <6.2.4": "6.2.4",
      "ws@>=7 <7.5.11": "7.5.11",
      "ws@>=8 <8.21.0": "8.21.0",
      "yaml@>=2.0.0 <2.8.3": "2.8.3"
    }
  }
}
