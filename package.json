{
  "name": "campus-app-kit",
  "private": true,
  "version": "1.1.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @campus/shared build && pnpm --filter @campus/institutions build && pnpm --filter @campus/bff build && node scripts/e2e-bff.mjs",
    "verify": "./scripts/verify-production-ready.sh",
    "setup:dev": "./scripts/setup-dev.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react-test-renderer": "^18.0.7",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "react-test-renderer": "^18.2.0",
    "tsx": "^4.19.2",
    "turbo": "^2.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "lightningcss": "1.30.1",
      "@isaacs/brace-expansion@<=5.0.0": "5.0.1",
      "@xmldom/xmldom@<0.8.13": "0.8.13",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "fast-xml-parser@<5.7.0": "5.7.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "node-forge@<1.4.0": "1.4.0",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=3.0.0 <3.0.2": "3.0.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "postcss": "8.5.13",
      "send@<0.19.0": "0.19.0",
      "tar@<7.5.11": "7.5.11",
      "undici@<6.24.0": "6.24.0",
      "uuid@<14.0.0": "14.0.0",
      "yaml@>=2.0.0 <2.8.3": "2.8.3"
    }
  }
}
