# Campus App Kit - Root Environment Variables
# Copy this file to .env for root-level commands and adjust as needed.
# See docs/runbook.md for detailed configuration

# =============================================================================
# BFF (Backend for Frontend) Configuration
# =============================================================================

# Institution ID (required)
# Available institutions: hfmt, example
# See packages/institutions/src/packs/ for available packs
INSTITUTION_ID=hfmt

# BFF server port (optional, default: 4000)
BFF_PORT=4000

# Optional bearer auth for private forks. Leave unset for this public template.
# Accepted true values: 1, true, yes, on. Invalid non-empty values fail closed.
# BFF_REQUIRE_AUTH=1
# BFF_AUTH_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# Trust proxy settings for rate limiting (optional, default: never)
# - never: ignore forwarded headers
# - auto: trust forwarded headers when peer is private/loopback
# - always: always use forwarded client IP (only behind trusted proxy)
BFF_TRUST_PROXY=never

# CORS origins (optional, comma-separated)
# Use "*" for development, specific origins for production
# CORS_ORIGINS=*

# Response cache TTL in seconds (optional, default: 300)
# BFF_DEFAULT_CACHE_TTL=300

# Maximum RRULE expansion window for public ICS feeds (optional, default: 90)
# RRULE_EXPANSION_HORIZON_DAYS=90

# =============================================================================
# Mobile App Configuration
# =============================================================================

# For BFF package commands, create apps/bff/.env from apps/bff/.env.example.
#
# For mobile app, create apps/mobile/.env with:
# EXPO_PUBLIC_BFF_BASE_URL=http://localhost:4000
#
# For production builds, set the public BFF URL:
# EXPO_PUBLIC_BFF_BASE_URL=https://api.your-domain.com
