# Production BFF image that separates compilation from a minimal non-root runtime.
FROM node:22.13.0-alpine AS builder

WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate

COPY pnpm-workspace.yaml package.json pnpm-lock.yaml tsconfig.base.json turbo.json ./
COPY apps/api/package.json apps/api/tsconfig*.json ./apps/api/
COPY apps/api/src ./apps/api/src
COPY packages/contracts/package.json packages/contracts/tsconfig*.json ./packages/contracts/
COPY packages/contracts/src ./packages/contracts/src
COPY packages/institutions/package.json packages/institutions/tsconfig*.json ./packages/institutions/
COPY packages/institutions/src ./packages/institutions/src

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @concourse/contracts build
RUN pnpm --filter @concourse/institutions build
RUN pnpm --filter @concourse/api build
RUN pnpm prune --prod

FROM node:22.13.0-alpine AS runner

ARG APP_VERSION=development

RUN apk add --no-cache dumb-init \
 && addgroup -S appgroup \
 && adduser -S appuser -G appgroup

WORKDIR /repo
ENV NODE_ENV=production \
    BFF_PORT=4000 \
    APP_VERSION=${APP_VERSION}

COPY --from=builder --chown=appuser:appgroup /repo/package.json /repo/pnpm-workspace.yaml /repo/pnpm-lock.yaml /repo/
COPY --from=builder --chown=appuser:appgroup /repo/node_modules /repo/node_modules
COPY --chown=appuser:appgroup LICENSE /repo/LICENSE

COPY --from=builder --chown=appuser:appgroup /repo/apps/api/package.json /repo/apps/api/package.json
COPY --from=builder --chown=appuser:appgroup /repo/apps/api/dist /repo/apps/api/dist

COPY --from=builder --chown=appuser:appgroup /repo/packages/contracts/package.json /repo/packages/contracts/package.json
COPY --from=builder --chown=appuser:appgroup /repo/packages/contracts/dist /repo/packages/contracts/dist

COPY --from=builder --chown=appuser:appgroup /repo/packages/institutions/package.json /repo/packages/institutions/package.json
COPY --from=builder --chown=appuser:appgroup /repo/packages/institutions/dist /repo/packages/institutions/dist

USER appuser
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD node -e "const http=require('node:http');const headers=process.env.BFF_AUTH_TOKEN?{authorization:'Bearer '+process.env.BFF_AUTH_TOKEN}:undefined;const req=http.get({host:'127.0.0.1',port:process.env.BFF_PORT||'4000',path:'/health',headers},res=>process.exit(res.statusCode>=200&&res.statusCode<300?0:1));req.on('error',()=>process.exit(1));req.setTimeout(4000,()=>{req.destroy();process.exit(1);});"
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "apps/api/dist/server.js"]
