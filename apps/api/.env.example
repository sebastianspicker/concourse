# Copy to apps/api/.env for local API development.
# Available IDs live in packages/institutions/src/packs/.
INSTITUTION_ID=hfmt

# Optional; defaults to 4000.
BFF_PORT=4000

# Optional bearer auth. Enabling it requires a long random token.
# Accepted true values: 1, true, yes, on. Invalid non-empty values fail closed.
# BFF_REQUIRE_AUTH=1
# BFF_AUTH_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# Keep proxy trust disabled unless the API is behind a reviewed proxy boundary.
BFF_TRUST_PROXY=never
# Prefer an exact proxy allowlist to BFF_TRUST_PROXY=always:
# BFF_TRUSTED_PROXIES=127.0.0.1,10.24.0.0/16,2001:db8:feed::/48

# Optional comma-separated browser origins.
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Optional response cache lifetime in seconds; defaults to 300.
# BFF_DEFAULT_CACHE_TTL=300

# Optional ICS recurrence window in days; defaults to 90.
# RRULE_EXPANSION_HORIZON_DAYS=90
