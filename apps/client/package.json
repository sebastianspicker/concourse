{
  "name": "@concourse/client",
  "private": true,
  "version": "1.2.0-alpha.1",
  "main": "index.js",
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "dev": "npx expo start --dev-client",
    "start": "npx expo start",
    "build:preview": "npx --yes eas-cli@20.5.1 build --profile preview",
    "build:production": "npx --yes eas-cli@20.5.1 build --profile production",
    "lint": "eslint app src config --ext .js,.ts,.tsx",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@babel/runtime": "7.28.6",
    "@concourse/institutions": "workspace:*",
    "@concourse/contracts": "workspace:*",
    "@expo/metro-runtime": "57.0.3",
    "@expo/vector-icons": "~15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "expo": "57.0.4",
    "expo-constants": "57.0.3",
    "expo-font": "57.0.0",
    "expo-linking": "57.0.2",
    "expo-router": "57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-web": "0.21.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.0",
    "@types/react": "19.2.17",
    "vite": "6.4.3",
    "vitest": "4.1.5"
  }
}
