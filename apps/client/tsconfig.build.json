// Type-checks the shipped client surface without test-only modules; Expo bundles the app itself.
{
  "extends": "./tsconfig.json",
  "include": ["config/**/*.js", "config/**/*.d.ts", "app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "app/**/*.test.ts",
    "app/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**"
  ]
}
