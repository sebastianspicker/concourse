// Emits mobile application modules without bundling test-only support code.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": false,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["config/**/*.js", "config/**/*.d.ts", "app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "app/**/*.test.ts",
    "app/**/*.test.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/test/**"
  ]
}
