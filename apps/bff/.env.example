# Concourse BFF environment variables.
# Copy this file to .env when running commands from apps/bff.

# Institution ID (required)
# Available institutions live in packages/institutions/src/packs/.
INSTITUTION_ID=hfmt

# BFF server port (optional, default: 4000)
BFF_PORT=4000

# Optional bearer auth for private forks. Leave unset for this public template.
# Accepted true values: 1, true, yes, on. Invalid non-empty values fail closed.
# BFF_REQUIRE_AUTH=1
# BFF_AUTH_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN

# Trust proxy settings for rate limiting (optional, default: never).
# Keep "never" unless the BFF is behind reviewed, explicitly named proxies.
BFF_TRUST_PROXY=never
# To trust a proxy allowlist, remove the line above and set exact IPs/CIDRs:
# BFF_TRUSTED_PROXIES=127.0.0.1,10.24.0.0/16,2001:db8:feed::/48
# "auto" is rejected. "always" is a legacy escape hatch and unsafe unless an
# isolated edge replaces all forwarded headers. Prefer BFF_TRUSTED_PROXIES.

# CORS origins (optional, comma-separated)
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Response cache TTL in seconds (optional, default: 300)
# BFF_DEFAULT_CACHE_TTL=300

# Maximum RRULE expansion window for public ICS feeds (optional, default: 90)
# RRULE_EXPANSION_HORIZON_DAYS=90
