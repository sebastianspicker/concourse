{
  "name": "@campus/bff",
  "private": true,
  "version": "1.1.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "pnpm --filter @campus/shared build && pnpm --filter @campus/institutions build",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:once": "tsx --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@campus/institutions": "workspace:*",
    "@campus/shared": "workspace:*",
    "rrule": "2.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.7",
    "@types/supertest": "6.0.3",
    "supertest": "7.0.0",
    "vite": "6.4.2",
    "vitest": "4.1.5"
  }
}
