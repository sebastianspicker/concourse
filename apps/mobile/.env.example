# Campus App Kit - Mobile App Environment Variables
# Copy this file to .env and adjust as needed

# =============================================================================
# BFF Connection (required)
# =============================================================================

# Public BFF base URL — required in both development and production.
# For local dev with a simulator: http://localhost:4000
# For local dev on a physical device: http://<your-machine-ip>:4000
# For production: https://api.your-domain.com
EXPO_PUBLIC_BFF_BASE_URL=http://localhost:4000

# =============================================================================
# Development Notes
# =============================================================================
#
# EXPO_PUBLIC_BFF_BASE_URL must be set; there is no automatic fallback.
# Copy this file to .env and set the value before starting the dev server.
#
# Do NOT use MOBILE_PUBLIC_BFF_URL (deprecated)
