{
  "name": "@campus/mobile",
  "private": true,
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "npx expo start --dev-client",
    "start": "npx expo start",
    "build:preview": "npx eas build --profile preview",
    "build:production": "npx eas build --profile production",
    "lint": "eslint app src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:e2e:build:ios": "detox build -c ios",
    "test:e2e:build:android": "detox build -c android",
    "test:e2e:ios": "detox test -c ios",
    "test:e2e:android": "detox test -c android",
    "test:e2e": "detox test -c ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@campus/institutions": "workspace:*",
    "@campus/shared": "workspace:*",
    "@expo/metro-runtime": "~3.2.3",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/netinfo": "^11.3.0",
    "@shopify/flash-list": "^1.6.0",
    "clsx": "2.1.1",
    "expo": "51.0.39",
    "expo-image": "2.0.7",
    "expo-router": "3.5.24",
    "nativewind": "4.2.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.0",
    "react-native-reanimated": "3.16.7",
    "react-native-safe-area-context": "4.10.1",
    "react-native-web": "0.19.13",
    "tailwind-merge": "2.6.1",
    "tailwindcss": "3.4.19",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "^18.0.7",
    "detox": "20.47.0",
    "jest": "29.7.0",
    "jest-circus": "29.7.0",
    "react-test-renderer": "18.3.1",
    "ts-jest": "29.4.6",
    "vitest": "2.1.9"
  }
}
